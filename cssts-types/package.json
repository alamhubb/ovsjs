{
  "name": "cssts-types",
  "version": "0.1.0",
  "description": "TypeScript type definitions for CssTs atomic styles",
  "type": "module",
  "main": "./index.d.ts",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./atoms/*": {
      "types": "./atoms/*"
    },
    "./runtime": {
      "types": "./runtime.d.ts"
    },
    "./global": {
      "types": "./global.d.ts"
    }
  },
  "files": [
    "*.d.ts",
    "atoms"
  ],
  "keywords": [
    "cssts",
    "typescript",
    "types",
    "atomic-css",
    "css-in-ts"
  ],
  "license": "MIT"
}
