{
  "name": "cssts-types",
  "version": "0.1.0",
  "description": "TypeScript type definitions for CssTs atomic styles",
  "type": "module",
  "main": "./index.d.ts",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts"
    },
    "./runtime": {
      "types": "./runtime.d.ts"
    },
    "./global": {
      "types": "./global.d.ts"
    },
    "./atoms": {
      "types": "./CsstsAtoms.d.ts"
    },
    "./dist/properties.json": {
      "default": "./dist/properties.json"
    }
  },
  "files": [
    "*.d.ts",
    "dist"
  ],
  "scripts": {
    "generate": "tsx src/generator/csstree-generator.ts",
    "build": "npm run generate"
  },
  "devDependencies": {
    "css-tree": "^3.1.0",
    "csstype": "^3.2.3",
    "mdn-data": "^2.25.0",
    "tsx": "^4.21.0"
  },
  "keywords": [
    "cssts",
    "typescript",
    "types",
    "atomic-css",
    "css-in-ts"
  ],
  "license": "MIT"
}
