{
  "$comment": "设计系统预设配置（用户可配置），定义 step 和预设值",

  "propertyUnits": {
    "$comment": "属性支持的单位分组，决定生成哪些单位的原子类",
    
    "width": ["px", "ratio"],
    "height": ["px", "ratio"],
    "min-width": ["px", "ratio"],
    "max-width": ["px", "ratio"],
    "min-height": ["px", "ratio"],
    "max-height": ["px", "ratio"],
    
    "padding": ["px"],
    "padding-top": ["px"],
    "padding-right": ["px"],
    "padding-bottom": ["px"],
    "padding-left": ["px"],
    
    "margin": ["px"],
    "margin-top": ["px"],
    "margin-right": ["px"],
    "margin-bottom": ["px"],
    "margin-left": ["px"],
    
    "gap": ["px"],
    "row-gap": ["px"],
    "column-gap": ["px"],
    
    "top": ["px", "ratio"],
    "right": ["px", "ratio"],
    "bottom": ["px", "ratio"],
    "left": ["px", "ratio"],
    "inset": ["px", "ratio"],
    
    "font-size": ["px", "rem"],
    "letter-spacing": ["px"],
    "word-spacing": ["px"],
    
    "border-width": ["px"],
    "border-radius": ["px"],
    "border-top-width": ["px"],
    "border-right-width": ["px"],
    "border-bottom-width": ["px"],
    "border-left-width": ["px"],
    "border-top-left-radius": ["px"],
    "border-top-right-radius": ["px"],
    "border-bottom-left-radius": ["px"],
    "border-bottom-right-radius": ["px"],
    
    "rotate": ["deg"],
    "transition-duration": ["ms"],
    
    "opacity": ["unitless"],
    "z-index": ["unitless"],
    "line-height": ["unitless"],
    "font-weight": ["unitless"],
    "flex-grow": ["unitless"],
    "flex-shrink": ["unitless"],
    "order": ["unitless"]
  },

  "unitPresets": {
    "$comment": "按单位类型的默认预设值",
    
    "px": {
      "values": [0, 2, 4, 6, 8, 10, 12, 14, 16, 20, 24, 32, 40, 48, 64, 80, 100, 120],
      "comment": "像素预设"
    },
    "rem": {
      "values": [0.5, 0.75, 1, 1.25, 1.5, 1.75, 2, 2.5, 3],
      "comment": "rem 预设"
    },
    "ratio": {
      "values": [0, 25, 33.33, 50, 66.67, 75, 100],
      "comment": "百分比/视口单位预设"
    },
    "deg": {
      "values": [0, 45, 90, 180, 270, 360],
      "comment": "角度预设"
    },
    "ms": {
      "values": [0, 100, 150, 200, 300, 500, 1000],
      "comment": "时间预设"
    }
  },
  
  "propertyPresets": {
    "$comment": "特定属性的预设配置（覆盖 unitPresets）",
    
    "opacity": {
      "step": 0.25,
      "values": [0, 0.25, 0.5, 0.75, 1],
      "comment": "透明度"
    },
    "z-index": {
      "values": [-1, 0, 10, 20, 30, 40, 50, 100, 999, 9999],
      "comment": "层级"
    },
    "line-height": {
      "step": 0.25,
      "values": [1, 1.25, 1.5, 1.75, 2],
      "comment": "行高"
    },
    "font-weight": {
      "step": 100,
      "values": [100, 200, 300, 400, 500, 600, 700, 800, 900],
      "comment": "字重"
    },
    "flex-grow": {
      "values": [0, 1],
      "comment": "flex 增长"
    },
    "flex-shrink": {
      "values": [0, 1],
      "comment": "flex 收缩"
    },
    "order": {
      "values": [-1, 0, 1, 2, 3, 4, 5],
      "comment": "排序"
    },
    "border-radius": {
      "values": [0, 2, 4, 6, 8, 12, 16, 9999],
      "comment": "圆角，9999 表示全圆"
    }
  }
}
