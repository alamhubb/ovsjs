{
  "$comment": "补充 css-tree 缺失的类型范围（min/max），这些是 CSS 规范定义的",
  
  "typeOverrides": {
    "alpha-value": {
      "min": 0,
      "max": 1,
      "comment": "透明度，CSS 规范定义为 0-1"
    }
  },
  
  "propertyOverrides": {
    "padding": { "min": 0, "comment": "padding 不支持负数" },
    "padding-top": { "min": 0 },
    "padding-right": { "min": 0 },
    "padding-bottom": { "min": 0 },
    "padding-left": { "min": 0 },
    "width": { "min": 0, "comment": "宽度不支持负数" },
    "height": { "min": 0 },
    "min-width": { "min": 0 },
    "max-width": { "min": 0 },
    "min-height": { "min": 0 },
    "max-height": { "min": 0 },
    "border-radius": { "min": 0 },
    "border-width": { "min": 0 },
    "font-size": { "min": 0 },
    "line-height": { "min": 0 },
    "gap": { "min": 0 },
    "row-gap": { "min": 0 },
    "column-gap": { "min": 0 }
  }
}
