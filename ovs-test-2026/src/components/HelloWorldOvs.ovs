import { ref } from 'vue'

// 第一层状态
let count1 = ref(0)

div(class="level-1", style="border: 2px solid red; padding: 20px; margin: 10px;") {
  h1 {
    "Level 1: "
    count1.value
  }

  button(
    onClick() {
      count1.value++
    },
    style="margin: 10px; padding: 8px 16px; cursor: pointer;"
  ) {
    "Click L1"
  }

  // 条件渲染：count1 为偶数时显示红色背景
  if (count1.value % 2 === 0) {
    div(style="background: red; padding: 10px; color: white;") {
      "偶数！"
    }
  }

  // 第二层（IIFE 作用域）
  div(class="level-2", style="border: 2px solid green; padding: 15px; margin: 10px;") {
    let count2 = ref(0)

    h2 {
      "Level 2: "
      count2.value
    }

    button(
      onClick() {
        count2.value++
      },
      style="margin: 10px; padding: 8px 16px; cursor: pointer;"
    ) {
      "Click L2"
    }
  }

  // map测试
  [1,2,3].map(item => div { item })

  // for循环测试
  for (let i = 0; i < 3; i++) {
    div(style="background: #eee; margin: 5px; padding: 5px;") {
      "Item "
      i
    }
  }

  // NoRenderBlock测试 - #{} 内的代码不会被渲染
  #{
    console.log("这是副作用代码，不会被渲染")
    let sideEffectVar = count1.value * 2
  }

}
