/**
 * Card Component (OVS)
 * 
 * 简单的卡片组件
 */

const cardStyle = {
  border: '1px solid #ebeef5',
  borderRadius: '4px',
  backgroundColor: '#fff',
  overflow: 'hidden',
  boxShadow: '0 2px 12px 0 rgba(0, 0, 0, 0.1)'
}

const headerStyle = {
  padding: '18px 20px',
  borderBottom: '1px solid #ebeef5',
  fontWeight: 'bold',
  fontSize: '16px'
}

const bodyStyle = {
  padding: '20px'
}

div(style = cardStyle) {
  if (props.title) {
    div(style = headerStyle) { props.title }
  }
  div(style = bodyStyle) {
    props.children
  }
}
