/**
 * Button Component (OVS)
 * 
 * 简单的按钮组件，使用纯 OVS 语法
 */

import { computed } from 'vue'

// 类型样式映射
const typeColors = {
  default: '#606266',
  primary: '#409eff',
  success: '#67c23a',
  warning: '#e6a23c',
  danger: '#f56c6c',
  info: '#909399'
}

const typeBgColors = {
  default: '#ffffff',
  primary: '#409eff',
  success: '#67c23a',
  warning: '#e6a23c',
  danger: '#f56c6c',
  info: '#909399'
}

// 计算样式
const buttonStyle = computed(() => {
  const type = props.type || 'default'
  const isDefault = type === 'default'
  return {
    display: 'inline-flex',
    justifyContent: 'center',
    alignItems: 'center',
    height: '32px',
    padding: '0 15px',
    fontSize: '14px',
    fontWeight: '500',
    border: '1px solid',
    borderRadius: '4px',
    cursor: props.disabled ? 'not-allowed' : 'pointer',
    transition: 'all 0.3s',
    userSelect: 'none',
    outline: 'none',
    backgroundColor: isDefault ? '#fff' : typeBgColors[type],
    color: isDefault ? typeColors[type] : '#fff',
    borderColor: isDefault ? '#dcdfe6' : typeBgColors[type],
    opacity: props.disabled ? 0.6 : 1
  }
})

// 点击处理
const handleClick = (evt) => {
  if (props.disabled || props.loading) {
    evt.stopPropagation()
    return
  }
  if (props.onClick) {
    props.onClick(evt)
  }
}

// 渲染
button(
  style = buttonStyle.value,
  disabled = props.disabled || undefined,
  type = props.nativeType || 'button',
  onClick = handleClick
) {
  // 加载图标
  if (props.loading) {
    span(style = { marginRight: '6px' }) { '⟳' }
  }
  
  // 子内容
  span { props.children }
}
