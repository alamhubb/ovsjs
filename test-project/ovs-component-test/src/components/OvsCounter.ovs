/**
 * Counter Component (OVS)
 * 
 * 简单的计数器组件
 */

import { ref } from 'vue'

const count = ref(props.initialValue || 0)

const containerStyle = {
  display: 'flex',
  alignItems: 'center',
  gap: '10px'
}

const buttonStyle = {
  width: '32px',
  height: '32px',
  fontSize: '18px',
  border: '1px solid #dcdfe6',
  borderRadius: '4px',
  backgroundColor: '#fff',
  cursor: 'pointer'
}

const countStyle = {
  fontSize: '24px',
  fontWeight: 'bold',
  minWidth: '60px',
  textAlign: 'center'
}

div(style = containerStyle) {
  button(style = buttonStyle, onClick() { count.value-- }) { '-' }
  span(style = countStyle) { count }
  button(style = buttonStyle, onClick() { count.value++ }) { '+' }
}
