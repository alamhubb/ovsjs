{
  "name": "os-language",
  "displayName": "ObjectScript Language",
  "description": "ObjectScript language support for VSCode - Multiple inheritance for JavaScript",
  "author": "alamhubb",
  "license": "MIT",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicholasyhuang/ovs"
  },
  "publisher": "alamhubb",
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "objectscript",
    "multiple-inheritance",
    "language-server"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "activationEvents": [
    "onLanguage:objectscript"
  ],
  "main": "./dist/extension.cjs",
  "contributes": {
    "languages": [
      {
        "id": "objectscript",
        "aliases": [
          "ObjectScript",
          "objectscript",
          "os"
        ],
        "extensions": [
          ".os"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "objectscript",
        "scopeName": "source.objectscript",
        "path": "./syntaxes/objectscript.tmLanguage.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "ObjectScript Configuration",
      "properties": {
        "objectscript.trace.server": {
          "scope": "window",
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the language server."
        }
      }
    }
  },
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "watch": "rollup -c rollup.config.mjs --watch",
    "test": "npm run test:dist",
    "test:source": "npx tsx tests/test-language-server.ts --source",
    "test:dist": "npx tsx tests/test-language-server.ts --dist",
    "test:all": "npm run test:source && npm run build && npm run test:dist",
    "pack": "vsce package",
    "release": "npm run test:all && npx vsce publish",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@swc/core": "^1.15.3",
    "@vscode/vsce": "^3.2.1",
    "rollup": "^4.53.3",
    "rollup-plugin-dts": "^6.3.0",
    "rollup-plugin-swc3": "^0.12.1",
    "typescript": "^5.6.2"
  }
}

