{
  "name": "{{projectName}}",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx server.js",
    "build": "npm run build:client && npm run build:server",
    "build:client": "tsx ./node_modules/vite/bin/vite.js build --outDir dist/client",
    "build:server": "tsx ./node_modules/vite/bin/vite.js build --ssr src/entry-server.ts --outDir dist/server",
    "preview": "cross-env NODE_ENV=production node server.js"
  },
  "dependencies": {
    "vue": "^3.5.25",
    "ovsjs": "^0.2.1",
    "ovs-compiler": "^0.2.1",
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.3",
    "@types/node": "^24.10.1",
    "@types/express": "^4.17.21",
    "@vitejs/plugin-vue": "^6.0.2",
    "@vue/tsconfig": "^0.8.1",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.1",
    "typescript": "~5.9.0",
    "vite": "^6.3.5",
    "vite-plugin-ovs": "^0.2.1"
  }
}

