{
  "compilerOptions": {
    "module": "ES2022",
    "useDefineForClassFields": true,
    "moduleResolution": "Node",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "target": "ES2015",
    "strict": false,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "lib": [
      "ES2019",
      "dom"
    ]
  },
  "include": ["packages/**/*"],
  "exclude": ["node_modules"]
}
